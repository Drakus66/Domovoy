{
  "_comment": [
    "Источник истины по версиям и совместимости компонентов Domovoy (Эпик 3K).",
    "MAJOR.MINOR задаётся здесь вручную, PATCH подставляет CI (номер прогона).",
    "",
    "Модель совместимости — три вида ограничений:",
    "  bus      — общая шина (Domovoy.Contracts живёт в каждом образе, провайдера нет).",
    "             Набор совместим, когда max(understands) <= min(speaks).",
    "  provides — именованный интерфейс, который компонент предоставляет по HTTP.",
    "             Поддерживается диапазон [minCompat, version].",
    "  requires — минимальная версия интерфейса, нужная компоненту.",
    "             Совместимо, когда minCompat <= requires <= version у провайдера.",
    "",
    "Зависимости объявляются на ИНТЕРФЕЙС, а не на сервис — у каждого интерфейса ровно",
    "один провайдер, поэтому произвольные циклы в графе структурно не возникают.",
    "",
    "ВАЖНО: правила обновления этого файла — docs/architecture/coding_standards_ru.md,",
    "раздел «Контракты и совместимость». Незаявленное изменение контракта роняет CI",
    "(job contract-guard) и, для публичной поверхности Domovoy.Contracts, локальную сборку."
  ],

  "registry": "ghcr.io/drakus66",
  "imagePrefix": "domovoy-",

  "sharedPaths": [
    "src/Common/**",
    "Directory.Build.props",
    "Directory.Packages.props",
    "Domovoy.sln",
    "build/components.json"
  ],

  "topology": {
    "image": "topology",
    "version": 1,
    "minCompat": 1,
    "paths": [
      "docker-compose.yml",
      "build/topology/**",
      "build/tools/gen-topology.mjs"
    ]
  },

  "components": [
    {
      "name": "db-gateway",
      "container": "db-gateway",
      "dockerfile": "src/Gateway/Domovoy.DbGateway/Dockerfile",
      "context": ".",
      "runtime": "dotnet",
      "version": "1.0",
      "bus": { "speaks": 1, "understands": 1 },
      "provides": { "db-api": { "version": 1, "minCompat": 1 } },
      "requires": {},
      "paths": ["src/Gateway/Domovoy.DbGateway/**"]
    },
    {
      "name": "automation-service",
      "container": "automation-service",
      "dockerfile": "src/Services/Domovoy.AutomationService/Dockerfile",
      "context": ".",
      "runtime": "dotnet",
      "version": "1.0",
      "bus": { "speaks": 1, "understands": 1 },
      "provides": { "automation-api": { "version": 1, "minCompat": 1 } },
      "requires": { "db-api": 1 },
      "paths": ["src/Services/Domovoy.AutomationService/**"]
    },
    {
      "name": "unified-device-service",
      "container": "unified-device-service",
      "dockerfile": "src/Services/Domovoy.UnifiedDeviceService/Dockerfile",
      "context": ".",
      "runtime": "dotnet",
      "version": "1.0",
      "bus": { "speaks": 1, "understands": 1 },
      "provides": {},
      "requires": {},
      "paths": ["src/Services/Domovoy.UnifiedDeviceService/**"]
    },
    {
      "name": "connectivity-service",
      "container": "connectivity-service",
      "dockerfile": "src/Services/Domovoy.Connectivity/Dockerfile",
      "context": ".",
      "runtime": "dotnet",
      "version": "1.0",
      "bus": { "speaks": 1, "understands": 1 },
      "provides": {},
      "requires": {},
      "paths": ["src/Services/Domovoy.Connectivity/**"]
    },
    {
      "name": "updater",
      "container": "domovoy-updater",
      "dockerfile": "src/Services/Domovoy.Updater/Dockerfile",
      "context": ".",
      "runtime": "dotnet",
      "version": "1.0",
      "bus": { "speaks": 1, "understands": 1 },
      "provides": { "updater-api": { "version": 1, "minCompat": 1 } },
      "requires": { "db-api": 1 },
      "paths": ["src/Services/Domovoy.Updater/**"]
    },
    {
      "name": "api-gateway",
      "container": "api-gateway",
      "dockerfile": "src/Gateway/Domovoy.ApiGateway/Dockerfile",
      "context": ".",
      "runtime": "dotnet",
      "version": "1.0",
      "bus": { "speaks": 1, "understands": 1 },
      "provides": { "rest-api": { "version": 1, "minCompat": 1 } },
      "requires": { "db-api": 1, "automation-api": 1, "updater-api": 1 },
      "paths": ["src/Gateway/Domovoy.ApiGateway/**"]
    },
    {
      "name": "plugin-supervisor",
      "container": "plugin-supervisor",
      "dockerfile": "src/Services/Domovoy.PluginSupervisor/Dockerfile",
      "context": ".",
      "runtime": "dotnet",
      "version": "1.0",
      "bus": { "speaks": 1, "understands": 1 },
      "provides": {},
      "requires": { "rest-api": 1 },
      "paths": ["src/Services/Domovoy.PluginSupervisor/**"]
    },
    {
      "name": "webui",
      "container": "webui",
      "dockerfile": "Dockerfile",
      "context": "src/UI/WebUI",
      "runtime": "node",
      "version": "1.0",
      "bus": null,
      "provides": {},
      "requires": { "rest-api": 1 },
      "paths": ["src/UI/WebUI/**"]
    }
  ]
}
