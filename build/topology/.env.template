# Шаблон переменных окружения боевой установки Domovoy (Эпик 3K).
#
# Этот файл — ЭТАЛОН, он приезжает вместе с релизом топологии. Рабочий `.env` на хосте
# принадлежит владельцу: при обновлении из него НИЧЕГО не удаляется и не перезаписывается,
# добавляются только отсутствующие ключи со значениями по умолчанию отсюда. Список
# добавленного пишется в журнал обновления и показывается в UI.
#
# Строки вида `KEY=value` — ключ и значение по умолчанию. Комментарии переносятся вместе
# с ключом при доливе, поэтому пишите их прямо над ключом.

# ============ Канал обновлений ============
# dev — свежие сборки из ветки develop; release — стабильные из master.
# Переключается из UI (/settings → Обновления); значение здесь синхронизируется автоматически,
# чтобы ручной `docker compose up -d` не откатил канал.
DOMOVOY_CHANNEL=release

# ============ Шина ============
# ⚠️ Смените пароль перед любым выносом системы за пределы доверенной сети.
RABBITMQ_DEFAULT_USER=domovoy
RABBITMQ_DEFAULT_PASS=change-me

# ============ Безопасность ============
# Пароль первичного пользователя `admin`, засевается один раз на пустой коллекции users.
DOMOVOY_ADMIN_PASSWORD=change-me
# Секрет подписи JWT. ⚠️ Замените длинным случайным значением: `openssl rand -base64 48`.
JWT_SECRET_KEY=change-me-to-a-long-random-value

# ============ Zigbee ============
# Путь к координатору. Найти: `ls -l /dev/serial/by-id/`.
ZIGBEE_DEVICE_PATH=/dev/serial/by-id/change-me

# ============ Удалённый доступ (профили edge/tunnel, по умолчанию выключены) ============
DOMOVOY_DOMAIN=
ACME_EMAIL=
TUNNEL_SSH_HOST=
TUNNEL_SSH_PORT=2222
TUNNEL_SSH_USER=domovoy
TUNNEL_REMOTE_BIND=127.0.0.1:8443

# ============ Push вне локальной сети (профиль push, по умолчанию выключен) ============
NTFY_BASE_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# ============ Локальная сборка ============
# Пусто в боевой установке: образы берутся из реестра, а не собираются на месте.
DOCKER_REGISTRY=
