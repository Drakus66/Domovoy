/memory-bank/
/.idea/
/.vs/
.claude/settings.local.json
**/bin/
**/obj/
*.log
**/node_modules/
*.tsbuildinfo

# Playwright artifacts (MCP browser-session scratch + standard test-runner output).
/.playwright-mcp/
/test-results/
/playwright-report/
/playwright/.cache/

# Runtime plugin drops (rw mount): track only the hand-authored manifest, never the built
# binaries or the persisted per-plugin settings (which may hold secrets like API keys).
/plugins/.settings/
/plugins/*/*
!/plugins/*/plugin.json
# Bookkeeping of the built-in plugin seeder (Epic 3K): which first-party plugins have been laid out
# and at which version. Host state, not source — and committing it would resurrect plugins the owner
# deleted, which the seeder deliberately avoids.
/plugins/.builtin-state.json

data/zigbee2mqtt/state.json
data/zigbee2mqtt/coordinator_backup.json
data/zigbee2mqtt/database.db

# Backup bundles (Epic 3A) — runtime host data written into the bind mount, not source.
/data/backups/
# SSH reverse-tunnel key material (Этап 3c autossh) — private keys, never commit.
/data/autossh/
CLAUDE.md

# Generated release-topology bundle (Epic 3K) — built by build/tools/gen-topology.mjs in CI.
# The source of truth is the root docker-compose.yml; this is a derived artifact.
/build/topology/dist/

# Installation directory of the delivery service (Epic 3K). DOMOVOY_INSTALL_DIR defaults to `.`
# (see the domovoy-updater volume in docker-compose.yml), so a local bring-up makes the WORKING COPY
# the installation root and the updater writes its host state straight into it: state/ (announced
# fingerprint, pinned.yml, topology.json, history.json, current-run.json), the unpacked releases/
# and the `current` symlink. Host state, not source — and committing it is not merely noise:
# state/announced.json says "this version set has already been announced", so a checkout carrying
# one would suppress the update notification a fresh house never saw (same reasoning as
# /plugins/.builtin-state.json above). docker-compose.override.yml lives in the same directory but
# IS source — a hand-written dev override — so it stays tracked.
/state/
/releases/
/current
