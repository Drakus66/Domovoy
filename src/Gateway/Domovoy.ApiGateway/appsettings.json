{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DbGateway": {
    "BaseUrl": "http://db-gateway:8080"
  },
  "JwtSettings": {
    "Enabled": false,
    "_secretKeyComment": "SecretKey намеренно отсутствует: задаётся только через JWT_SECRET_KEY в .env. Значение в репозитории — это значение, известное всем.",
    "Issuer": "domovoy",
    "Audience": "domovoy-clients",
    "ExpiryMinutes": 60,
    "RefreshExpiryDays": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Prometheus": {
    "BaseUrl": "http://prometheus:9090"
  }
}
