{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Ocelot": "Information"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyForDomovoyShouldBeVeryLongAndComplex",
    "Issuer": "domovoy",
    "Audience": "domovoy-clients",
    "ExpiryMinutes": 60
  },
  "Prometheus": {
    "BaseUrl": "http://prometheus:9090"
  }
}
