{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Supervisor": {
    "PluginsRoot": "plugins",
    "GpuAvailable": false,
    "InternetAvailable": true,
    "RestartBackoffSeconds": 10,
    "MaxRestarts": 5
  }
}
