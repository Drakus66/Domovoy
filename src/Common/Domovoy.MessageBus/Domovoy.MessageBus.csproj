<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <!-- BackgroundService/IHostApplicationLifetime для SystemControlListener. Раньше приезжали
             транзитивно через Domovoy.Common — объявлено явно, чтобы ссылку на Common можно было снять. -->
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
        <PackageReference Include="RabbitMQ.Client" />
    </ItemGroup>

    <ItemGroup>
      <!-- Ссылки на Domovoy.Common здесь нет намеренно. IMessageBus лежал в проекте Common, хотя
           namespace у него всегда был Domovoy.MessageBus; из-за этого шина тянула Common, а вместе с
           ним Serilog и Mongo-sink — в том числе во внепроцессные плагины, которым нужен ровно один
           интерфейс. Файл переехал к своему namespace, зависимость разорвана. -->
      <ProjectReference Include="..\Domovoy.Contracts\Domovoy.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
      <!-- Коэрсия настроек плагина (PluginSettingsService.Coerce) проверяется напрямую: её поведение
           зависит от типа T, и через Get<T> покрыть все ветки нельзя, не заводя плагин целиком. -->
      <InternalsVisibleTo Include="Domovoy.CommutePlugin.Tests"/>
    </ItemGroup>

</Project>
