    { "name": "Кухня", "heater_device": "kitchen_convector", "sensor_device": "kitchen_temp",
      "heat_gain_at_full": 2.1, "ambient_coupling": 0.12, "initial_temp": 18 }
  ],
  "co2_zones": [
    { "name": "Гостиная", "vent_device": "ventilation", "sensor_device": "living_co2",
